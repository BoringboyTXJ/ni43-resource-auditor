# Both roles accept OpenAI-compatible /chat/completions endpoints.
# Base URLs end in /v1 (or your provider's documented compatible base).
EXTRACTOR_BASE_URL=https://api.openai.com/v1
EXTRACTOR_MODEL=gpt-4o
EXTRACTOR_API_KEY=
EXTRACTOR_API_FORMAT=chat
EXTRACTOR_REASONING_EFFORT=
EXTRACTOR_JSON_SCHEMA=false
EXTRACTOR_ENABLE_THINKING=
CRITIC_BASE_URL=
CRITIC_MODEL=
CRITIC_API_KEY=
CRITIC_API_FORMAT=chat
CRITIC_REASONING_EFFORT=
CRITIC_JSON_SCHEMA=false
# Chat only, opt in if supported: JSON_SCHEMA=true sends strict response_format.
# Qwen ENABLE_THINKING=false disables thinking; empty leaves provider default.
CRITIC_ENABLE_THINKING=
# Set false if your gateway does not support response_format=json_object.
LLM_JSON_MODE=true
LLM_STREAM=true
LLM_TIMEOUT_SECONDS=120
EVOLUTION_LOG=data/evolution.jsonl
MAX_PDF_MB=40
MAX_CONTEXT_CHARS=100000
MAX_SELECTED_PAGES=24
PDF_PARSER=mineru
# Docker bundles MinerU + Basic CPU models; no parser configuration needed.
# Native Python only: set the absolute path of a separate MinerU interpreter.
MINERU_PYTHON=
MINERU_TIER=basic
MINERU_TIMEOUT_SECONDS=1800
